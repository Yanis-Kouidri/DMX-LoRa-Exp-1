    {
      "type": "table",
      "title": "Seuil de rentabilité p* de la sonde ($charge octets, RX2 en SF$rx2)",
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 11,
        "h": 8
      },
      "description": "p* = E_sonde ratée / E_repli, en prenant prudemment le coût d'une sonde réussie égal à celui d'une sonde ratée (plan expérimental, section 9). La sonde est rentable si elle réussit avec une probabilité supérieure à p*. Un tiret est un cas pas encore mesuré.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "efwxza0hb47wgf"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "efwxza0hb47wgf"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH e AS (\n  SELECT sf, mode, avg(energy_mj) AS mj\n  FROM ppk2_results\n  WHERE payload_bytes = $charge AND rx2_sf = $rx2 AND rx1_delay_ms = 1000\n  GROUP BY sf, mode\n)\nSELECT 'SF' || r.sf AS \"Repli\",\n  r.mj AS \"Énergie du repli\",\n  max(p.mj / r.mj) FILTER (WHERE p.sf = 7) AS \"p* sonde SF7\",\n  max(p.mj / r.mj) FILTER (WHERE p.sf = 8) AS \"p* sonde SF8\",\n  max(p.mj / r.mj) FILTER (WHERE p.sf = 9) AS \"p* sonde SF9\",\n  1 - max(p.mj / r.mj) FILTER (WHERE p.sf = $sonde) AS \"Gain si p = 1 (sonde SF$sonde)\"\nFROM e r\nLEFT JOIN e p ON p.mode = 'cnf' AND p.sf <= 9\nWHERE r.mode = 'uncnf' AND r.sf >= 10\nGROUP BY r.sf, r.mj\nORDER BY r.sf",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "md"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "noValue": "–",
          "color": {
