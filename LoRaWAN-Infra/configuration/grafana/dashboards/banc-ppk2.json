    {
      "type": "table",
      "title": "Séries mesurées",
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 24,
        "h": 12
      },
      "description": "Une ligne par série et par SF. CV : écart-type rapporté à la moyenne. RX2 allongées : fenêtre RX2 de plus de 1,2 fois la médiane de la série (gardées dans les statistiques). Fichiers : nom de la série dans Mote/banc-ppk2/, où le README donne la provenance du code.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "efwxza0hb47wgf"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "efwxza0hb47wgf"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH med AS (\n  SELECT series, sf, percentile_cont(0.5) WITHIN GROUP (ORDER BY rx2_ms) AS rx2_median\n  FROM ppk2_messages\n  WHERE valid\n  GROUP BY series, sf\n), m AS (\n  SELECT ppk2_messages.*, med.rx2_median\n  FROM ppk2_messages\n  LEFT JOIN med USING (series, sf)\n  WHERE NOT warmup\n)\nSELECT to_char(s.started_at AT TIME ZONE 'Europe/Paris', 'DD/MM HH24:MI') AS \"Début\",\n  CASE s.mode WHEN 'cnf' THEN 'Sonde ratée' ELSE 'Uplink non confirmé' END AS \"Message\",\n  'SF' || m.sf AS \"SF\",\n  s.payload_bytes AS \"Octets\",\n  'SF' || s.rx2_sf AS \"RX2\",\n  s.rx1_delay_ms / 1000.0 AS \"rx1_delay\",\n  count(*) FILTER (WHERE m.valid) AS \"Retenus\",\n  count(*) FILTER (WHERE NOT m.valid) AS \"Écartés\",\n  avg(m.energy_mj) FILTER (WHERE m.valid) AS \"Moyenne\",\n  stddev_samp(m.energy_mj) FILTER (WHERE m.valid) AS \"Écart-type\",\n  100.0 * stddev_samp(m.energy_mj) FILTER (WHERE m.valid) / avg(m.energy_mj) FILTER (WHERE m.valid) AS \"CV\",\n  min(m.energy_mj) FILTER (WHERE m.valid) AS \"Min\",\n  max(m.energy_mj) FILTER (WHERE m.valid) AS \"Max\",\n  avg(m.tx_ms) FILTER (WHERE m.valid) AS \"Émission\",\n  count(*) FILTER (WHERE m.valid AND m.rx2_ms > 1.2 * m.rx2_median) AS \"RX2 allongées\",\n  CASE WHEN s.in_results THEN 'résultats' ELSE 'contrôle de méthode' END AS \"Rôle\",\n  s.name AS \"Fichiers\"\nFROM m\nJOIN ppk2_series s ON s.name = m.series\nGROUP BY s.name, s.started_at, s.mode, m.sf, s.payload_bytes, s.rx2_sf, s.rx1_delay_ms, s.in_results\nORDER BY s.started_at, m.sf",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "–",
          "custom": {
            "align": "center"
          }
        },
        "overrides": [
          {
