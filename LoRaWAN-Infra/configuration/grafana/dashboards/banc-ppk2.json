          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH e AS (\n  SELECT sf, mode, avg(energy_mj) AS mj\n  FROM ppk2_results\n  WHERE payload_bytes = $charge AND rx2_sf = $rx2 AND rx1_delay_ms = 1000\n  GROUP BY sf, mode\n)\nSELECT g.p AS \"p\",\n  g.p - (SELECT mj FROM e WHERE mode = 'cnf' AND sf = $sonde) / (SELECT mj FROM e WHERE mode = 'uncnf' AND sf = 10) AS \"Repli SF10\",\n  g.p - (SELECT mj FROM e WHERE mode = 'cnf' AND sf = $sonde) / (SELECT mj FROM e WHERE mode = 'uncnf' AND sf = 11) AS \"Repli SF11\",\n  g.p - (SELECT mj FROM e WHERE mode = 'cnf' AND sf = $sonde) / (SELECT mj FROM e WHERE mode = 'uncnf' AND sf = 12) AS \"Repli SF12\"\nFROM (SELECT generate_series(0, 100) / 100.0 AS p) g\nORDER BY 1",
