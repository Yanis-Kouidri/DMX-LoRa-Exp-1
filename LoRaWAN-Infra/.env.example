POSTGRES_USER=chirpstack
# Generate with: openssl rand -hex 32 (must stay URL-safe, it is used in DSNs)
POSTGRES_PASSWORD=
POSTGRES_DB=chirpstack

# ChirpStack API token signing secret, generate with: openssl rand -base64 32
CHIRPSTACK_API_SECRET=

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# Password of the read-only grafana_reader PostgreSQL role used by the Grafana
# datasource (set in Grafana, not read by docker compose). Generate with: openssl rand -hex 32
GRAFANA_DB_PASSWORD=
