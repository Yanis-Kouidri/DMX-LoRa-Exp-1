    {
      "type": "barchart",
      "title": "Durée d'un message de 6 octets : où passe le temps",
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 10
      },
      "description": "Durées moyennes, du début de l'émission à la fin de RX2. Les attentes (environ 2 s, module au repos à 4,3 mA) et RX2 ne dépendent pas du SF : c'est le coût fixe d'un message.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "efwxza0hb47wgf"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "efwxza0hb47wgf"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'SF' || sf AS \"SF\",\n  avg(tx_ms) AS \"Émission\",\n  avg(duration_ms - tx_ms - rx1_ms - rx2_ms) AS \"Attentes au repos\",\n  avg(rx1_ms) AS \"RX1\",\n  avg(rx2_ms) AS \"RX2\"\nFROM ppk2_results\nWHERE mode = 'uncnf' AND payload_bytes = 6 AND rx2_sf = 12 AND rx1_delay_ms = 1000\nGROUP BY sf\nORDER BY sf",
          "refId": "A"
        }
      ],
