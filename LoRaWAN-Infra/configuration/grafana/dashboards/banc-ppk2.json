    {
      "type": "barchart",
      "title": "Énergie d'un message de 6 octets : où passe l'énergie (estimation)",
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 10
      },
      "description": "Estimation : le banc mesure l'énergie totale du message, pas celle de chaque phase. Attentes : courant de repos mesuré avant le message, sur la durée des attentes. RX1 et RX2 : durée de la fenêtre multipliée par la puissance en réception, déduite de l'écart entre les séries RX2 en SF12 et RX2 en SF9. Émission : le reste de l'énergie mesurée. Le total de chaque barre est l'énergie mesurée.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "efwxza0hb47wgf"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "efwxza0hb47wgf"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH paires AS (\n  -- Puissance en réception au-dessus du fond : écart d'énergie entre RX2 en\n  -- SF12 et en SF9, rapporté à l'écart de durée de la fenêtre RX2\n  SELECT (avg(energy_mj) FILTER (WHERE rx2_sf = 12) - avg(energy_mj) FILTER (WHERE rx2_sf = 9))\n       / (avg(rx2_ms) FILTER (WHERE rx2_sf = 12) - avg(rx2_ms) FILTER (WHERE rx2_sf = 9)) AS mj_par_ms\n  FROM ppk2_results\n  WHERE payload_bytes = 6 AND rx1_delay_ms = 1000\n  GROUP BY sf, mode\n  HAVING count(*) FILTER (WHERE rx2_sf = 9) > 0 AND count(*) FILTER (WHERE rx2_sf = 12) > 0\n), rx AS (\n  SELECT avg(mj_par_ms) AS mj_par_ms FROM paires\n), m AS (\n  SELECT sf, energy_mj,\n    rx.mj_par_ms * rx1_ms AS e_rx1,\n    rx.mj_par_ms * rx2_ms AS e_rx2,\n    (i_idle_ma - i_sleep_ma) * source_mv / 1000.0 * (duration_ms - tx_ms - rx1_ms - rx2_ms) / 1000.0 AS e_attente\n  FROM ppk2_results, rx\n  WHERE mode = 'uncnf' AND payload_bytes = 6 AND rx2_sf = 12 AND rx1_delay_ms = 1000\n)\nSELECT 'SF' || sf AS \"SF\",\n  avg(energy_mj - e_attente - e_rx1 - e_rx2) AS \"Émission\",\n  avg(e_attente) AS \"Attentes au repos\",\n  avg(e_rx1) AS \"RX1\",\n  avg(e_rx2) AS \"RX2\"\nFROM m\nGROUP BY sf\nORDER BY sf",
          "refId": "A"
        }
      ],
      "options": {
        "xField": "SF",
        "orientation": "horizontal",
        "stacking": "normal",
        "showValue": "never",
        "groupWidth": 0.72,
        "barWidth": 0.92,
        "barRadius": 0.08,
        "xTickLabelRotation": 0,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "mJ",
          "decimals": 1,
          "min": 0,
          "noValue": "–",
          "custom": {
            "fillOpacity": 90,
            "lineWidth": 0,
            "axisBorderShow": false,
            "axisGridShow": true,
            "axisLabel": "Énergie moyenne (mJ)"
          }
        },
