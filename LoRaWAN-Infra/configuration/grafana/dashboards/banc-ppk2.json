    {
      "type": "trend",
      "title": "Répétabilité : écart de chaque message à la médiane de son SF",
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 24,
        "h": 8
      },
      "description": "Série choisie par le sélecteur « Série ». Messages retenus, dans l'ordre d'émission ; quand la série enchaîne plusieurs SF, chaque message est comparé à la médiane de son SF. Un point isolé vers le haut est en général une fenêtre RX2 allongée (préambule détecté).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "efwxza0hb47wgf"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "efwxza0hb47wgf"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT m.attempt AS \"Tentative\",\n  100.0 * (m.energy_mj / med.mj - 1) AS \"Écart à la médiane\"\nFROM ppk2_messages m\nJOIN (\n  SELECT sf, percentile_cont(0.5) WITHIN GROUP (ORDER BY energy_mj) AS mj\n  FROM ppk2_messages\n  WHERE series = '$serie' AND valid\n  GROUP BY sf\n) med ON med.sf = m.sf\nWHERE m.series = '$serie' AND m.valid\nORDER BY m.attempt",
          "refId": "A"
        }
      ],
      "options": {
        "xField": "Tentative",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
