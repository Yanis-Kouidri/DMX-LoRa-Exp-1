      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "efwxza0hb47wgf"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  r.time AS \"Time\",\n  r.dev_eui AS \"DevEUI\",\n  CASE WHEN j.id IS NULL THEN 'Non' ELSE 'Oui' END AS \"Accepté\",\n  j.raw_event->>'devAddr' AS \"DevAddr\",\n  get_byte(decode(r.phy_payload_base64, 'base64'), 17)\n    | (get_byte(decode(r.phy_payload_base64, 'base64'), 18) << 8) AS \"DevNonce\",\n  r.spreading_factor AS \"SF\",\n  r.rssi_dbm AS \"RSSI\",\n  r.snr_db AS \"SNR\",\n  r.frequency_hz AS \"Fréquence\",\n  r.gateway_id AS \"Gateway\",\n  upper(encode(decode(r.phy_payload_base64, 'base64'), 'hex')) AS \"PHYPayload (hex)\"\nFROM gateway_events r\nLEFT JOIN LATERAL (\n  SELECT d.id, d.raw_event\n  FROM device_events d\n  WHERE d.event_type = 'join'\n    AND d.dev_eui = r.dev_eui\n    AND d.time BETWEEN r.time AND r.time + interval '10 seconds'\n  ORDER BY d.time\n  LIMIT 1\n) j ON true\nWHERE r.direction = 'event'\n  AND r.event_type = 'up'\n  AND r.m_type = 'JoinRequest'\n  AND $__timeFilter(r.time)\n  AND r.dev_eui IN (${dev_eui:sqlstring})\nORDER BY r.time DESC\nLIMIT $limit;",
          "refId": "A"
        }
      ],
      "title": "Dernières requêtes de join OTAA",
      "type": "table"
