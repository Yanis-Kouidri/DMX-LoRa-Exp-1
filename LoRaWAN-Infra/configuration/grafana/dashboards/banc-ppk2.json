          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  (SELECT count(*) FROM ppk2_series WHERE in_results) AS \"Séries de résultats\",\n  (SELECT count(*) FROM ppk2_results) AS \"Messages retenus\",\n  avg(energy_mj) FILTER (WHERE sf = 7) AS \"Message SF7\",\n  avg(energy_mj) FILTER (WHERE sf = 12) AS \"Message SF12\",\n  avg(energy_mj) FILTER (WHERE sf = 12) / avg(energy_mj) FILTER (WHERE sf = 7) AS \"SF12 / SF7\"\nFROM ppk2_results\nWHERE mode = 'uncnf' AND payload_bytes = 6 AND rx2_sf = 12 AND rx1_delay_ms = 1000",
          "refId": "A"
