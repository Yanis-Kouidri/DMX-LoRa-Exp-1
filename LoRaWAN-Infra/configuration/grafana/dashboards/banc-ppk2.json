          "rawSql": "SELECT 'SF' || sf || ' · ' || CASE mode WHEN 'cnf' THEN 'sonde ratée' ELSE 'non confirmé' END AS \"Message\",\n  avg(energy_mj) FILTER (WHERE rx1_delay_ms = 1000) AS \"rx1_delay 1 s\",\n  avg(energy_mj) FILTER (WHERE rx1_delay_ms = 3000) AS \"rx1_delay 3 s\"\nFROM ppk2_results\nWHERE payload_bytes = 6 AND rx2_sf = 12\nGROUP BY sf, mode\nHAVING count(*) FILTER (WHERE rx1_delay_ms = 3000) > 0 AND count(*) FILTER (WHERE rx1_delay_ms = 1000) > 0\nORDER BY sf",
